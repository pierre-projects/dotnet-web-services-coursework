<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="BasicHttpsBinding_Encryption">
					<security mode="Transport" />
				</binding>

				<binding name="BasicHttpsBinding_Stockquote">
					<security mode="Transport" />
				</binding>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint address="https://venus.sod.asu.edu/WSRepository/Services/EncryptionWcf/Service.svc" binding="basicHttpBinding"
					  bindingConfiguration="BasicHttpsBinding_Encryption" contract="encryptdecryptservice.IService"
					  name="BasicHttpsBinding_Encryption" />

			<endpoint address="https://venus.sod.asu.edu/WSRepository/Services/Stockquote/Service.svc" binding="basicHttpBinding"
					  bindingConfiguration="BasicHttpsBinding_Stockquote" contract="stockQuoteService.IService"
					  name="BasicHttpsBinding_Stockquote" />
		</client>
    </system.serviceModel>
</configuration>