<?xml version="1.0"?>
<configuration>
	<system.web>
		<authorization>
			<!-- Explicitly allow TA  -->
			<allow users="TA" />

			<!-- Add other staff usernames if needed:
      <allow users="StaffUser1" />
      -->

			<!-- Nobody else should ever access staff pages -->
			<deny users="*" />
		</authorization>
	</system.web>
</configuration>
